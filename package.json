{
  "name": "kharon-website",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build:sw": "node scripts/build-sw.js",
    "build:astro": "astro build",
    "build:css": "pnpx tsx scripts/purge-css.ts",
    "build:cron": "node scripts/wrap-worker-cron.mjs",
    "build": "pnpm build:sw && pnpm build:astro && pnpm build:cron && pnpm build:css",
    "build:portal": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-deploy-artifacts.ps1 portal",
    "build:website": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-deploy-artifacts.ps1 website",
    "build:production": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-deploy-artifacts.ps1 all",
    "lint": "eslint .",
    "test": "playwright test",
    "audit:site": "pnpx tsx scripts/audit-site.ts",
    "validate:site": "pnpm build:production && pnpm audit:site",
    "portal:hash-password": "pnpx tsx scripts/hash-password.ts",
    "portal:monitor": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/portal-monitor.ps1",
    "portal:qa:roles": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/portal-role-qa.ps1",
    "portal:backup:d1": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/portal-backup.ps1",
    "portal:retention:report": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/portal-retention-report.ps1",
    "preview": "astro preview",
    "auth:cloudflare": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 login",
    "cloudflare:whoami": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 whoami",
    "cloudflare:list-projects": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 list",
    "cloudflare:create-project": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 create",
    "cloudflare:domains": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 domains",
    "cloudflare:retry-portal": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 retry-portal",
    "cloudflare:check-portal": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 check-portal",
    "wrangler:dev:portal": "wrangler dev -c wrangler.portal.jsonc",
    "wrangler:dev:website": "wrangler dev -c wrangler.website.jsonc",
    "wrangler:tail:portal": "wrangler tail -c wrangler.portal.jsonc",
    "wrangler:tail:website": "wrangler tail -c wrangler.website.jsonc",
    "wrangler:secret:portal": "wrangler secret put -c wrangler.portal.jsonc",
    "wrangler:secret:website": "wrangler secret put -c wrangler.website.jsonc",
    "deploy:website:artifact": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-website-artifact.ps1 -ArtifactPath .deploy/website",
    "deploy:portal:artifact": "pnpx wrangler deploy --config .deploy/portal/server/wrangler.json",
    "deploy:website": "pnpm build:website && pnpm deploy:website:artifact",
    "deploy:portal": "pnpm build:portal && pnpm deploy:portal:artifact",
    "deploy:cloudflare": "pnpm build:production && pnpm deploy:portal:artifact && pnpm deploy:website:artifact",
    "deploy:cloudflare:ps": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflare-pages.ps1 production",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.0",
    "@openrouter/agent": "^0.7.0",
    "@openrouter/sdk": "^0.12.79",
    "@sentinel/types": "file:packages/types",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/workers-types": "^4.20260530.1",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "ws": "^8.20.1",
    "yaml": "^2.9.0",
    "sharp": "^0.35.0",
    "astro": "^7.1.0",
    "js-yaml": "^4.2.1",
    "postcss": "^8.5.18",
    "svgo": "^4.0.2",
    "undici": "^7.27.3",
    "vite": "^7.3.4"
  }
}
